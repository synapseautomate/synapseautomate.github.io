{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Workflow Output Schema v2",
  "type": "object",
  "required": [
    "case_id",
    "decision",
    "evidence",
    "unknowns",
    "human_gate"
  ],
  "properties": {
    "case_id": {
      "type": "string",
      "minLength": 1
    },
    "decision": {
      "enum": [
        "AUTO_PROCEED",
        "HUMAN_REVIEW",
        "HUMAN_APPROVAL",
        "BLOCK_AND_ESCALATE"
      ]
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "field",
          "source_ref",
          "source_rights"
        ],
        "properties": {
          "field": {
            "type": "string"
          },
          "source_ref": {
            "type": "string"
          },
          "source_rights": {
            "enum": [
              "synthetic",
              "public",
              "customer-authorized"
            ]
          }
        }
      }
    },
    "unknowns": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "human_gate": {
      "type": "object",
      "required": [
        "required",
        "owner_role",
        "reason"
      ],
      "properties": {
        "required": {
          "type": "boolean"
        },
        "owner_role": {
          "type": [
            "string",
            "null"
          ]
        },
        "reason": {
          "type": "string"
        }
      }
    },
    "normalized": {
      "type": "object",
      "properties": {
        "amount": {
          "type": [
            "number",
            "null"
          ]
        },
        "currency": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[A-Z]{3}$"
        },
        "date": {
          "type": [
            "string",
            "null"
          ],
          "format": "date"
        },
        "unit": {
          "type": [
            "string",
            "null"
          ]
        },
        "company_id": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    }
  },
  "additionalProperties": false
}
